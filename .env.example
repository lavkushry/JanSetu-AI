JANSETU_ENV=local
JANSETU_DATABASE_URL=postgres://js_auth:js_auth-local@localhost:5438/jansetu?sslmode=disable
JANSETU_SOCIAL_DATABASE_URL=postgres://js_social:js_social-local@localhost:5438/jansetu?sslmode=disable
JANSETU_OPERATIONS_DATABASE_URL=postgres://js_ops:js_ops-local@localhost:5438/jansetu?sslmode=disable
JANSETU_PUBLICATION_DATABASE_URL=postgres://js_publication:js_publication-local@localhost:5438/jansetu?sslmode=disable
JANSETU_WORKER_DATABASE_URL=postgres://js_worker:js_worker-local@localhost:5438/jansetu?sslmode=disable
JANSETU_VAULT_SERVICE_URL=http://127.0.0.1:8082
JANSETU_VAULT_SERVICE_TOKEN=local-vault-service-token-fictional-2026
# Only the vault process receives these; paths below are relative to services/backend.
JANSETU_VAULT_DATABASE_URL=postgres://js_vault:js_vault-local@localhost:5438/jansetu_vault?sslmode=disable
JANSETU_VAULT_AUTH_DATABASE_URL=postgres://js_vault_auth:js_vault_auth-local@localhost:5438/jansetu?sslmode=disable
JANSETU_VAULT_KEYS_FILE=../../infra/vault/local-keys.json
# Only migration / isolated integration tests receive administrator credentials.
JANSETU_MIGRATION_DATABASE_URL=postgres://jansetu:jansetu-local@localhost:5438/jansetu?sslmode=disable
JANSETU_MIGRATION_VAULT_DATABASE_URL=postgres://jansetu:jansetu-local@localhost:5438/jansetu_vault?sslmode=disable
JANSETU_API_URL=http://127.0.0.1:8081
JANSETU_HTTP_ADDR=127.0.0.1:8081
JANSETU_WEB_ORIGIN=http://localhost:3100
# The default login flow uses the local Keycloak realm; start it with make identity.
JANSETU_AUTH_MODE=oidc
JANSETU_OIDC_ISSUER=http://localhost:8180/realms/jansetu
JANSETU_OIDC_CLIENT_ID=jansetu-web
# Optional confidential-client secret belongs only in the API environment.
# JANSETU_OIDC_CLIENT_SECRET=
# Docker Compose sets its own local backchannel; leave unset for host processes.
# JANSETU_OIDC_BACKCHANNEL=http://identity:8080

# Local private photo volume (host development); never serve this directory statically.
JANSETU_MEDIA_DATABASE_URL=postgres://js_media:js_media-local@localhost:5438/jansetu?sslmode=disable
JANSETU_MEDIA_WORKER_DATABASE_URL=postgres://js_media_worker:js_media_worker-local@localhost:5438/jansetu?sslmode=disable
JANSETU_MEDIA_DIR=/tmp/jansetu-media
JANSETU_OCR_BINARY=tesseract
# Optional on host; run make vision-setup first, then export the same absolute
# path in API and media-worker environments. Compose enables the baked adapter.
# JANSETU_VISION_BINARY=/absolute/path/to/JanSetu-AI/services/vision/run

# Optional experimental local pothole adapter; set same absolute path for API/worker.
JANSETU_POTHOLE_BINARY=

# Recommendation serving starts in shadow. Rollout: 1, 5, 25, then 100 after measured gates.
JANSETU_RECOMMENDATION_TARGET=127.0.0.1:50051
JANSETU_RECOMMENDATION_MODE=shadow
JANSETU_RECOMMENDATION_ROLLOUT=0
