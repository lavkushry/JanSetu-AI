JANSETU_ENV=local
JANSETU_DATABASE_URL=postgres://jansetu:jansetu-local@localhost:5438/jansetu?sslmode=disable
JANSETU_VAULT_URL=postgres://jansetu:jansetu-local@localhost:5438/jansetu_vault?sslmode=disable
JANSETU_API_URL=http://127.0.0.1:8081
JANSETU_HTTP_ADDR=127.0.0.1:8081
JANSETU_WEB_ORIGIN=http://localhost:3100
# The default login flow uses the local Keycloak realm; start it with make identity.
JANSETU_AUTH_MODE=oidc
JANSETU_OIDC_ISSUER=http://localhost:8180/realms/jansetu
JANSETU_OIDC_CLIENT_ID=jansetu-web
# Optional confidential-client secret belongs only in the API environment.
# JANSETU_OIDC_CLIENT_SECRET=
# Docker Compose sets its own local backchannel; leave unset for host processes.
# JANSETU_OIDC_BACKCHANNEL=http://identity:8080
